<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.hallowelt.mediawiki.services</groupId>
	<artifactId>html2pdf</artifactId>
	<version>2.2.3-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>html2pdf</name>
	<description>PDF renderer service for MediaWiki</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<maven.build.timestamp.format>yyyyMMdd'T'HHmmss'Z'</maven.build.timestamp.format>
		<html2pdf.build-id>${maven.build.timestamp}</html2pdf.build-id>
		<!-- 1.1.37 has issue #214: rowspan cells inside <thead> lose background/border, fixed in 1.1.74 -->
		<openhtml.version>1.1.108</openhtml.version>
		<!-- Spring Boot 4.1.1 uses Tomcat 11.0.24, but CVEs CVE-2026-65182, CVE-2026-65905 and CVE-2026-68525 are only fixed in 11.0.25 -->
		<tomcat.version>11.0.25</tomcat.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-core</artifactId>
			<version>${openhtml.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-pdfbox</artifactId>
			<version>${openhtml.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-java2d</artifactId>
			<version>${openhtml.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-rtl-support</artifactId>
			<version>${openhtml.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-slf4j</artifactId>
			<version>${openhtml.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-svg-support</artifactId>
			<version>${openhtml.version}</version>
		</dependency>

		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.23.2</version>
		</dependency>
	</dependencies>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>commons-io</groupId>
				<artifactId>commons-io</artifactId>
				<version>2.22.0</version>
			</dependency>
			<dependency>
				<groupId>commons-logging</groupId>
				<artifactId>commons-logging</artifactId>
				<version>1.3.6</version>
			</dependency>
			<dependency>
				<groupId>xml-apis</groupId>
				<artifactId>xml-apis</artifactId>
				<version>1.4.01</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
						<configuration>
							<additionalProperties>
								<id>${html2pdf.build-id}</id>
							</additionalProperties>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<configuration>
					<overwrite>true</overwrite>
					<nonFilteredFileExtensions>
						<nonFilteredFileExtension>ttf</nonFilteredFileExtension>
						<nonFilteredFileExtension>otf</nonFilteredFileExtension>
						<nonFilteredFileExtension>woff</nonFilteredFileExtension>
						<nonFilteredFileExtension>woff2</nonFilteredFileExtension>
					</nonFilteredFileExtensions>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.7.1</version>
				<executions>
					<execution>
						<id>unpack-openhtmltopdf-accessibility-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>io.github.openhtmltopdf</groupId>
									<artifactId>openhtmltopdf-pdfbox</artifactId>
									<version>${openhtml.version}</version>
									<classifier>sources</classifier>
									<type>jar</type>
									<outputDirectory>${project.build.directory}/generated-sources/openhtmltopdf</outputDirectory>
									<includes>com/openhtmltopdf/pdfboxout/PdfBoxAccessibilityHelper.java</includes>
								</artifactItem>
								<artifactItem>
									<groupId>io.github.openhtmltopdf</groupId>
									<artifactId>openhtmltopdf-svg-support</artifactId>
									<version>${openhtml.version}</version>
									<classifier>sources</classifier>
									<type>jar</type>
									<outputDirectory>${project.build.directory}/generated-sources/openhtmltopdf</outputDirectory>
									<includes>com/openhtmltopdf/svgsupport/SVGImageExtension.java</includes>
								</artifactItem>
							</artifactItems>
							<overWriteReleases>true</overWriteReleases>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>patch-openhtmltopdf-table-header-structure</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<replace
									file="${project.build.directory}/generated-sources/openhtmltopdf/com/openhtmltopdf/pdfboxout/PdfBoxAccessibilityHelper.java"
									token="logIncompatibleChild(parent, child, TableBodyStructualElement.class);"
									value="if (child instanceof GenericStructualElement &amp;&amp; ((GenericStructualElement) child).box != null &amp;&amp; ((GenericStructualElement) child).box.getStyle().isIdent(CSSName.DISPLAY, IdentValue.TABLE_HEADER_GROUP)) { GenericStructualElement header = (GenericStructualElement) child; this.thead.box = header.box; this.thead.page = header.page; for (AbstractTreeItem headerChild : header.children) { headerChild.parent = this.thead; this.thead.children.add(headerChild); } } else { logIncompatibleChild(this, child, TableBodyStructualElement.class); }"
									failOnNoReplacements="true" />
								<replace
									file="${project.build.directory}/generated-sources/openhtmltopdf/com/openhtmltopdf/pdfboxout/PdfBoxAccessibilityHelper.java"
									token="logIncompatibleChild(parent, child, FigureContentItem.class);"
									value="logIncompatibleChild(this, child, FigureContentItem.class);"
									failOnNoReplacements="true" />
								<replace
									file="${project.build.directory}/generated-sources/openhtmltopdf/com/openhtmltopdf/svgsupport/SVGImageExtension.java"
									token="private static class ImageBridge extends SVGImageElementBridge {"
									value="private static class ImageBridge extends com.hallowelt.mediawiki.services.html2pdf.ResilientSvgImageBridge {"
									failOnNoReplacements="true" />
								<replace
									file="${project.build.directory}/generated-sources/openhtmltopdf/com/openhtmltopdf/svgsupport/SVGImageExtension.java"
									token="public BridgeCtx(UserAgent userAgent, UserAgentCallback userAgentCallback) {"
									value="@Override public BridgeContext createBridgeContext(org.apache.batik.anim.dom.SVGOMDocument document) { return SVGImageExtension.newBridge(document.isSVG12() ? &quot;1.2&quot; : &quot;1.1&quot;, getUserAgent(), uac); }&#10;        public BridgeCtx(UserAgent userAgent, UserAgentCallback userAgentCallback) {"
									failOnNoReplacements="true" />
								<replace
									file="${project.build.directory}/generated-sources/openhtmltopdf/com/openhtmltopdf/svgsupport/SVGImageExtension.java"
									token="public Bridge12Ctx(UserAgent userAgent, UserAgentCallback userAgentCallback) {"
									value="@Override public BridgeContext createBridgeContext(org.apache.batik.anim.dom.SVGOMDocument document) { return SVGImageExtension.newBridge(document.isSVG12() ? &quot;1.2&quot; : &quot;1.1&quot;, getUserAgent(), uac); }&#10;        public Bridge12Ctx(UserAgent userAgent, UserAgentCallback userAgentCallback) {"
									failOnNoReplacements="true" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>add-patched-openhtmltopdf-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/openhtmltopdf</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
